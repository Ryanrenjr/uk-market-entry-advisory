# The site's canonical URL, used to build absolute canonical links,
# hreflang alternates, Open Graph/Twitter URLs, sitemap.xml and robots.txt.
#
# Required in production — the build fails without it, rather than silently
# shipping metadata that points at localhost.
#
# In development this can be omitted; it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com
